data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep

# trained artifacts
models/**
!models/.gitkeep

reports/figures/*.png
reports/eda/*.json
reports/logs/*.jsonl
reports/metrics/*.json

node_modules/
frontend/dist/
.env
*.db
*.db-wal
*.db-shm
*.db.head
*.db.head.tmp
.pytest_cache/
.ipynb_checkpoints/

# Phase 3+ outputs: trained models are regenerated with `python -m aegisflow train`
artifacts/models/**
artifacts/archive/**
# local experiment runs (same kind of binary model files)
artifacts/experiments/**
# archived copies of processed data (derived from the licensed dataset)
data/archive/**
# per-run pytest basetemp directories
.pytest_*/

# regenerated by every `preprocess` run; tracking them would dirty the tree after the README quickstart
reports/data_quality_report.md
reports/data_quality_report.json
